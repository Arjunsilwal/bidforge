# BidForge v1 Environment Configuration

# Copy to .env and fill in. .env is gitignored — never commit real values.
# v1 ships no authentication, so do not expose the API to untrusted networks.

# Application
APP_NAME=BidForge
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed by CORS (comma-separated). Keep this to the exact origins
# that serve the UI; it is never widened to "*".
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# Database (PostgreSQL + pgvector)
# REQUIRED: docker-compose refuses to start without POSTGRES_PASSWORD. Generate one
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
POSTGRES_USER=bidforge
POSTGRES_PASSWORD=
POSTGRES_DB=bidforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://bidforge:CHANGE_ME@localhost:5432/bidforge_db

# MLflow Tracking Server & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=bidforge-cost-model-v1

# FRED (Federal Reserve Economic Data) API
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
FRED_SERIES_ID=WPUSI012011 # Producer Price Index by Commodity: Construction Materials

# Optional LLM Integration (for narrative justification synthesis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
