# BidForge v1 Environment Configuration

# Application
APP_NAME=BidForge
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-random-secret-key-32-chars

# API Server
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# Database (PostgreSQL + pgvector)
POSTGRES_USER=bidforge
POSTGRES_PASSWORD=bidforge_password
POSTGRES_DB=bidforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://bidforge:bidforge_password@localhost:5432/bidforge_db

# MLflow Tracking Server & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=bidforge-cost-model-v1

# FRED (Federal Reserve Economic Data) API
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
FRED_SERIES_ID=WPUSI012011 # Producer Price Index by Commodity: Construction Materials

# Optional LLM Integration (for narrative justification synthesis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage & Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_DIR=./models
