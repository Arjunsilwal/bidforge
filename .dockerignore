# Keep secrets, history, and local state out of the build context. Both Dockerfiles use
# `COPY . .`, so anything not excluded here is baked into the published image layers —
# including a real .env, which would ship live credentials inside the image.
.env
.env.*
!.env.example
*.pem
*.key

.git
.gitignore
.github

.venv*/
venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data, trained artifacts, and experiment logs
*.db
*.db-journal
*.db-wal
*.db-shm
mlruns/
models/
data/raw/
data/processed/
tmp_model_artifacts/
notebooks/

# Docs and editor cruft — not needed at runtime
docs/
*.md
!README.md
.vscode/
.idea/
.DS_Store
